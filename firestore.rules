rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ニッポンゲッサーの対戦ルーム
    match /geoRooms/{roomId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['status', 'players', 'rounds', 'settings'])
                    && request.resource.data.rounds.size() <= 10;
      allow update: if request.resource.data.rounds.size() <= 10;
      allow delete: if false;
    }
  }
}
